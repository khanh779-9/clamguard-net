<UserControl x:Class="ClamGuard.Antivirus.Controls.ClamGuardDialog"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization"
             UseLayoutRounding="True"
             MinWidth="440" MaxWidth="580">
    <Border Background="{DynamicResource Brush.SurfaceElevated}"
            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
            CornerRadius="12" Padding="24"
            Effect="{DynamicResource Effect.DialogShadow}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" MaxHeight="320" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header: Icon badge + Title + Dismiss (x) button -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Icon Badge with Accent Tint -->
                <Border Width="42" Height="42" CornerRadius="10"
                        Background="{Binding AccentBrush}" Opacity="0.14" />
                <Path Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="{Binding AccentBrush}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Data="{Binding IconData}" Stretch="Uniform" />

                <!-- Dialog Title -->
                <TextBlock Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center"
                           Text="{Binding Title}"
                           FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           TextWrapping="Wrap" />

                <!-- Close / Dismiss button (top-right) -->
                <Button Grid.Column="2" Width="30" Height="30"
                        VerticalAlignment="Top" Click="CloseButton_Click"
                        AutomationProperties.Name="{loc:Loc toast.dismiss}"
                        ToolTip="{loc:Loc toast.dismiss}"
                        Style="{DynamicResource Style.ButtonGhost}">
                    <Path Width="11" Height="11" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.4"
                          Data="{DynamicResource Icon.Close}" Stretch="Uniform" />
                </Button>
            </Grid>

            <!-- Dialog Body Message (Scrollable if long like File Inspector details) -->
            <ScrollViewer Grid.Row="1" Margin="0,16,0,0"
                          VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <TextBlock Text="{Binding Message}"
                           FontSize="12" LineHeight="19"
                           Foreground="{DynamicResource Brush.TextSecondary}"
                           TextWrapping="Wrap" />
            </ScrollViewer>

            <!-- Action Buttons Footer -->
            <Grid Grid.Row="2" Margin="0,22,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="1" x:Name="SecondaryButton" Click="SecondaryButton_Click"
                        Margin="0,0,10,0" MinWidth="100" Height="36"
                        Visibility="{Binding HasSecondary, Converter={StaticResource BoolToVisibilityConverter}}"
                        Content="{Binding SecondaryText}"
                        Style="{DynamicResource Style.ButtonSecondary}" />

                <Button Grid.Column="2" x:Name="PrimaryButton" Click="PrimaryButton_Click"
                        MinWidth="104" Height="36"
                        Content="{Binding PrimaryText}"
                        Style="{DynamicResource Style.ButtonPrimary}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
