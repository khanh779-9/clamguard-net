<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
                    xmlns:controls="clr-namespace:ClamGuard.Antivirus.Controls"
                    xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization">
    <Style x:Key="Style.ClamGuardWindow" TargetType="Window">
        <Setter Property="ResizeMode" Value="CanResize" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Window">
                    <Border x:Name="WindowFrame"
                            Background="{DynamicResource Brush.WindowFrame}"
                            BorderBrush="{DynamicResource Brush.WindowBorder}"
                            BorderThickness="1">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="38" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <!-- Custom caption/title bar is part of the window template. -->
                            <Border x:Name="PART_TitleBar"
                                    Grid.Row="0"
                                    Background="{DynamicResource Brush.TitleBar}">
                                <Grid Margin="14,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- Window Branding -->
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="24" Height="24" Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="6">
                                            <Path Width="13" Height="13" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Fill="{DynamicResource Brush.Primary}" Stretch="Uniform"
                                                  Data="{DynamicResource Icon.AppLogo}" />
                                        </Border>
                                        <TextBlock Text="{loc:Loc app.title}" Margin="9,0,0,0" FontSize="12" FontWeight="SemiBold"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.TextPrimary}" />
                                    </StackPanel>

                                    <!-- Window Control Caption Buttons -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Stretch">
                                        <Button x:Name="PART_Minimize"
                                                Width="46" Height="38"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                AutomationProperties.Name="{loc:Loc window.minimize}" ToolTip="{loc:Loc window.minimize}"
                                                Style="{DynamicResource Style.WindowButton}">
                                            <Path Width="10.5" Height="10.5"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="Uniform" Data="{DynamicResource Icon.Minimize}" />
                                        </Button>
                                        <Button x:Name="PART_Maximize"
                                                Width="46" Height="38"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                AutomationProperties.Name="{loc:Loc window.maximize}" ToolTip="{loc:Loc window.maximize}"
                                                Style="{DynamicResource Style.WindowButton}">
                                            <Path x:Name="PART_MaximizeIcon" Width="10.5" Height="10.5"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                  Stretch="Uniform" Data="{DynamicResource Icon.Maximize}" />
                                        </Button>
                                        <Button x:Name="PART_Close"
                                                Width="46" Height="38"
                                                shell:WindowChrome.IsHitTestVisibleInChrome="True"
                                                AutomationProperties.Name="{loc:Loc window.close}" ToolTip="{loc:Loc window.close}"
                                                Style="{DynamicResource Style.WindowCloseButton}">
                                            <Path Width="10.5" Height="10.5"
                                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                                  StrokeThickness="1.5"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Stretch="Uniform" Data="{DynamicResource Icon.Close}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Grid.Row="1" Background="{DynamicResource Brush.WindowBorder}" />

                            <Grid Grid.Row="2" ClipToBounds="True">
                                <ContentPresenter Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}" />
                                <controls:ClamGuardToastHost x:Name="PART_ToastHost"
                                                              HorizontalAlignment="Right" VerticalAlignment="Bottom"
                                                              Margin="0,0,22,18" Panel.ZIndex="500" />
                                <Grid x:Name="PART_DialogOverlay" Visibility="Collapsed" Panel.ZIndex="1000"
                                      Background="{DynamicResource Brush.Overlay}" ClipToBounds="True">
                                    <ItemsControl x:Name="PART_DialogHost" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                            </Grid>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <!-- Maximized -->
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="WindowFrame" Property="Padding" Value="8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

    </Style>

    <!-- Implicit style cho ClamGuardWindow dựa trên Style.ClamGuardWindow -->
    <Style TargetType="{x:Type controls:ClamGuardWindow}" BasedOn="{StaticResource Style.ClamGuardWindow}" />
</ResourceDictionary>
