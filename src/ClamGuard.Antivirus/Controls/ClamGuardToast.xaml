<UserControl x:Class="ClamGuard.Antivirus.Controls.ClamGuardToast"
             x:Name="root"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization"
             UseLayoutRounding="True">
    <Border Background="{DynamicResource Brush.SurfaceElevated}"
            BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
            Width="390" MinHeight="62" CornerRadius="10"
            Effect="{DynamicResource Effect.DialogShadow}">
        <Grid Margin="12,10,10,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Accent Icon Pill Badge -->
            <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                <Border Width="34" Height="34" CornerRadius="8"
                        Background="{Binding AccentBrush}" Opacity="0.14" />
                <Path Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                      Stroke="{Binding AccentBrush}" StrokeThickness="1.6"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                      Stretch="Uniform" Data="{Binding IconData}" />
            </Grid>

            <!-- Text Content -->
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                <TextBlock Text="{Binding Title}" FontSize="12.5" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding Message}" Margin="0,3,0,0"
                           FontSize="11" Foreground="{DynamicResource Brush.TextSecondary}"
                           LineHeight="16" TextWrapping="Wrap" MaxHeight="64" TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <!-- Close Button -->
            <Button x:Name="CloseButton" Grid.Column="2" Width="28" Height="28"
                    VerticalAlignment="Top" Margin="0,-2,-2,0" Click="CloseButton_Click"
                    AutomationProperties.Name="{loc:Loc toast.dismiss}"
                    ToolTip="{loc:Loc toast.dismiss}"
                    Style="{DynamicResource Style.ButtonGhost}">
                <Path Width="10.5" Height="10.5" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.4"
                      Data="{DynamicResource Icon.Close}" Stretch="Uniform" />
            </Button>
        </Grid>
    </Border>
</UserControl>
