<UserControl x:Class="ClamGuard.Antivirus.Controls.LoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid Background="{DynamicResource Brush.Overlay}">
        <Border Background="{DynamicResource Brush.SurfaceElevated}"
                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1"
                CornerRadius="14" Padding="28,24"
                MinWidth="300" MaxWidth="440"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Effect="{DynamicResource Effect.DialogShadow}">
            <StackPanel HorizontalAlignment="Center">
                <!-- Spinner Animation Host -->
                <Grid Width="50" Height="50" HorizontalAlignment="Center">
                    <!-- Background static track ring -->
                    <Ellipse Stroke="{DynamicResource Brush.PrimarySoft}" StrokeThickness="3.5" />

                    <!-- Rotating active indicator arc -->
                    <Path Stroke="{DynamicResource Brush.Primary}" StrokeThickness="3.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                          Data="M 25,3 A 22,22 0 0 1 47,25"
                          RenderTransformOrigin="0.5,0.5">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotate" Angle="0" />
                        </Path.RenderTransform>
                        <Path.Triggers>
                            <EventTrigger RoutedEvent="Loaded">
                                <BeginStoryboard>
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="SpinnerRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360"
                                                         Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </EventTrigger>
                        </Path.Triggers>
                    </Path>

                    <!-- Center Shield Icon -->
                    <Path Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center"
                          Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.5"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Data="{DynamicResource Icon.Shield}" Stretch="Uniform" />
                </Grid>

                <!-- Status Title Text -->
                <TextBlock x:Name="StatusTitleText"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center"
                           Text="{Binding BusyTitle, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Loading...'}"
                           FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource Brush.TextPrimary}"
                           TextAlignment="Center" />

                <!-- Status Subtitle / Details Text -->
                <TextBlock x:Name="StatusSubText"
                           Margin="0,6,0,0"
                           HorizontalAlignment="Center"
                           Text="{Binding BusyMessage, RelativeSource={RelativeSource AncestorType=UserControl}, FallbackValue='Please wait'}"
                           FontSize="11.5"
                           Foreground="{DynamicResource Brush.TextMuted}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" MaxWidth="360" />

                <!-- Optional Progress Bar -->
                <ProgressBar x:Name="ProgressBar"
                             Margin="0,14,0,0"
                             Height="4"
                             IsIndeterminate="True"
                             Style="{DynamicResource Style.ProgressBar}"
                             Visibility="{Binding ShowProgress, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Visible}" />

                <!-- Optional Cancel Action Button -->
                <Button x:Name="CancelButton"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Center"
                        Style="{DynamicResource Style.ButtonGhost}"
                        Height="28" Padding="12,2"
                        Click="CancelButton_Click"
                        Visibility="{Binding ShowCancel, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}, FallbackValue=Collapsed}">
                    <StackPanel Orientation="Horizontal">
                        <Path Width="10" Height="10" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.4"
                              Data="{DynamicResource Icon.Close}" Stretch="Uniform" Margin="0,0,5,0" />
                        <TextBlock Text="{loc:Loc common.cancel}" FontSize="11" Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
