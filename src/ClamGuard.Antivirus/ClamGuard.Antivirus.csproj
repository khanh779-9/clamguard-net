<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultApplicationDefinition>true</EnableDefaultApplicationDefinition>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyTitle>ClamGuard Antivirus</AssemblyTitle>
    <AssemblyProduct>ClamGuard Antivirus</AssemblyProduct>
    <RootNamespace>ClamGuard.Antivirus</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ClamGuard.Core\ClamGuard.Core.csproj" />
    <ProjectReference Include="..\ClamGuard.Database\ClamGuard.Database.csproj" />
    <ProjectReference Include="..\ClamGuard.Scanner\ClamGuard.Scanner.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Localization\*.lng" />
    <None Update="Localization\*.lng">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="README.md">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
