<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ClamGuard.Antivirus.Converters">

    <Style x:Key="Style.ProgressBar" TargetType="ProgressBar">
        <Setter Property="Height" Value="5" />
        <Setter Property="Background" Value="{DynamicResource Brush.InputDisabled}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Primary}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid ClipToBounds="True">
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3"
                                HorizontalAlignment="Left" Width="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="Indicator" Property="Width" Value="75" />
                            <Trigger.EnterActions>
                                <!-- The custom template replaced the default WPF
                                     animation; without this the indeterminate
                                     bar is a static strip that looks frozen.
                                     A width-relative sweep is not expressible in
                                     a XAML storyboard, so pulse instead. -->
                                <BeginStoryboard x:Name="IndeterminateStoryboard">
                                    <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                        <DoubleAnimation
                                            Storyboard.TargetName="Indicator"
                                            Storyboard.TargetProperty="Opacity"
                                            From="1" To="0.3" Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="IndeterminateStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.ToolTip" TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource Brush.SurfaceElevated}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Placement" Value="Mouse" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="1" CornerRadius="5" Padding="9,6">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
