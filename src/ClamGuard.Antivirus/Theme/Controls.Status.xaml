<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:ClamGuard.Antivirus.Converters">

    <Style x:Key="Style.NavItem" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextSecondary}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid ClipToBounds="True">
                        <Border x:Name="BackgroundChrome" Background="Transparent" />
                        <Border x:Name="AccentLine" Width="3" HorizontalAlignment="Left"
                                Background="Transparent" Margin="0" />
                        <Grid Margin="14,0,12,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <Path x:Name="NavIcon" Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform"
                                  Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource NavIconConverter}}" />
                            <ContentPresenter x:Name="NavContent" Grid.Column="1" VerticalAlignment="Center" Margin="10,0,0,0"
                                              RecognizesAccessKey="True" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="BackgroundChrome" Property="Background" Value="{DynamicResource Brush.SidebarItemHover}" /></Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.SidebarItemSelectedText}" />
                            <Setter TargetName="NavIcon" Property="Stroke" Value="{DynamicResource Brush.SidebarItemSelectedText}" />
                            <Setter TargetName="BackgroundChrome" Property="Background" Value="{DynamicResource Brush.SidebarItemSelected}" />
                            <Setter TargetName="AccentLine" Property="Background" Value="{DynamicResource Brush.SidebarAccent}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="AccentLine" Property="Background" Value="{DynamicResource Brush.Focus}" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <Style x:Key="Style.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="Track" Background="{DynamicResource Brush.InputDisabled}"
                                BorderBrush="{DynamicResource Brush.BorderStrong}" BorderThickness="1" CornerRadius="12" />
                        <Ellipse x:Name="Thumb" Width="18" Height="18" Margin="3,0,0,0"
                                 HorizontalAlignment="Left" Fill="{DynamicResource Brush.TextMuted}" />
                        <Border x:Name="FocusRing" Margin="-2" BorderBrush="Transparent" BorderThickness="2"
                                CornerRadius="14" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{DynamicResource Brush.Success}" />
                            <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Success}" />
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource Brush.PrimaryContent}" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.BorderStrong}" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" /></Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Track" Property="Opacity" Value="0.5" /><Setter TargetName="Thumb" Property="Opacity" Value="0.6" /></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Style.ToolsReadyMetric" TargetType="TextBlock" BasedOn="{StaticResource Style.MetricValue}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DatabaseReady}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Style.ReadyDot" TargetType="Ellipse">
        <Setter Property="Fill" Value="{DynamicResource Brush.Danger}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DatabaseReady}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource Brush.Success}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Style.ReadyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Danger}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DatabaseReady}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Style.ReadyBadge" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.DangerSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.DangerBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="9,5" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding DatabaseReady}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Brush.SuccessSoft}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.SuccessBorder}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Style.RealtimeStateText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.TextMuted}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding RealtimeEnabled}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Style.PrivilegeText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Warning}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding SystemIsAdministrator}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
