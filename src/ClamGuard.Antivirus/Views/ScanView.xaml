<UserControl x:Class="ClamGuard.Antivirus.Views.ScanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization"
             xmlns:models="clr-namespace:ClamGuard.Antivirus.Models"
             xmlns:core="clr-namespace:ClamGuard.Core;assembly=ClamGuard.Core"
             xmlns:controls="clr-namespace:ClamGuard.Antivirus.Controls"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <!-- MODE 1: Scan Setup & In-Progress Dashboard Panel -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0"
                      Visibility="{Binding IsShowingScanResults, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <StackPanel>
                <!-- CARD A: Header Banner -->
                <Border Style="{DynamicResource Style.CardEmphasis}" Padding="12">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="8">
                            <Path Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.6" Data="{DynamicResource Icon.Scan}" Stretch="Uniform" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center">
                            <TextBlock Text="{loc:Loc scan.scan_files}" Style="{DynamicResource Style.CardTitle}" FontSize="15" />
                            <TextBlock Text="{loc:Loc scan.scan_files_desc}" Margin="0,3,0,0" Style="{DynamicResource Style.MutedText}" />
                        </StackPanel>
                        <Border Grid.Column="2" Background="{DynamicResource Brush.SurfaceSubtle}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="1" Padding="8,4" CornerRadius="4">
                            <TextBlock Text="{Binding DatabaseStatusText}" Style="{DynamicResource Style.ReadyText}" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>


                <!-- CARD B: Scan Modes (always available while the database is ready) -->
                <Border Margin="0,11,0,0" Style="{DynamicResource Style.Card}" Padding="12">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{loc:Loc scan.modes}" Style="{DynamicResource Style.SectionLabel}" />
                            <Button Grid.Column="1" Command="{Binding CancelScanCommand}"
                                    Style="{DynamicResource Style.ButtonSecondary}" Height="28" Padding="10,4"
                                    Visibility="{Binding IsScanning, Converter={StaticResource BoolToVisibilityConverter}}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Width="9" Height="9" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="1.8"
                                          Data="{DynamicResource Icon.Close}" Margin="0,0,5,0" Stretch="Uniform" />
                                    <TextBlock Text="{loc:Loc scan.cancel_scan}" Foreground="{DynamicResource Brush.Danger}"
                                               FontSize="10" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <UniformGrid Columns="3" Rows="2" Margin="0,10,0,0">
                            <!-- Smart Scan -->
                            <Border Style="{DynamicResource Style.CardQuiet}" Padding="11" Margin="0,0,8,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" Background="{DynamicResource Brush.PrimarySoft}">
                                            <Path Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.5" Data="{DynamicResource Icon.Scan}" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{loc:Loc scan.smart}" Style="{DynamicResource Style.CardTitle}" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc scan.smart_desc}" Style="{DynamicResource Style.MutedText}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" MinHeight="28" />
                                    <Button Margin="0,10,0,0" Command="{Binding SmartScanCommand}" Style="{DynamicResource Style.ButtonPrimary}" Height="30" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{loc:Loc scan.start}" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Critical Scan -->
                            <Border Style="{DynamicResource Style.CardQuiet}" Padding="11" Margin="4,0,4,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" Background="{DynamicResource Brush.WarningSoft}">
                                            <Path Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource Brush.Warning}" StrokeThickness="1.5" Data="{DynamicResource Icon.Shield}" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{loc:Loc scan.critical}" Style="{DynamicResource Style.CardTitle}" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc scan.critical_desc}" Style="{DynamicResource Style.MutedText}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" MinHeight="28" />
                                    <Button Margin="0,10,0,0" Command="{Binding CriticalScanCommand}" Style="{DynamicResource Style.ButtonSecondary}" Height="30" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{loc:Loc scan.start}" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Memory Scan -->
                            <Border Style="{DynamicResource Style.CardQuiet}" Padding="11" Margin="8,0,0,8">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" Background="{DynamicResource Brush.SuccessSoft}">
                                            <Path Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.5" Data="{DynamicResource Icon.Database}" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{loc:Loc scan.memory}" Style="{DynamicResource Style.CardTitle}" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc scan.memory_desc}" Style="{DynamicResource Style.MutedText}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" MinHeight="28" />
                                    <Button Margin="0,10,0,0" Command="{Binding MemoryScanCommand}" Style="{DynamicResource Style.ButtonSecondary}" Height="30" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{loc:Loc scan.start}" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Startup Scan -->
                            <Border Style="{DynamicResource Style.CardQuiet}" Padding="11" Margin="0,8,8,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" Background="{DynamicResource Brush.SurfaceSubtle}">
                                            <Path Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5" Data="{DynamicResource Icon.Refresh}" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{loc:Loc scan.startup}" Style="{DynamicResource Style.CardTitle}" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc scan.startup_desc}" Style="{DynamicResource Style.MutedText}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" MinHeight="28" />
                                    <Button Margin="0,10,0,0" Command="{Binding StartupScanCommand}" Style="{DynamicResource Style.ButtonSecondary}" Height="30" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{loc:Loc scan.start}" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Scan File -->
                            <Border Style="{DynamicResource Style.CardQuiet}" Padding="11" Margin="4,8,4,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" Background="{DynamicResource Brush.PrimarySoft}">
                                            <Path Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.5" Data="{DynamicResource Icon.File}" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{loc:Loc scan.file_scan}" Style="{DynamicResource Style.CardTitle}" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc scan.file_scan_desc}" Style="{DynamicResource Style.MutedText}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" MinHeight="28" />
                                    <Button Margin="0,10,0,0" Command="{Binding QuickScanCommand}" Style="{DynamicResource Style.ButtonSecondary}" Height="30" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{loc:Loc scan.select_file}" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!-- Scan Folder -->
                            <Border Style="{DynamicResource Style.CardQuiet}" Padding="11" Margin="8,8,0,0">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="30" Height="30" Background="{DynamicResource Brush.SurfaceSubtle}">
                                            <Path Width="15" Height="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5" Data="{DynamicResource Icon.Folder}" Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{loc:Loc scan.folder_scan}" Style="{DynamicResource Style.CardTitle}" FontSize="12" Margin="9,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{loc:Loc scan.folder_scan_desc}" Style="{DynamicResource Style.MutedText}" FontSize="10" Margin="0,7,0,0" TextWrapping="Wrap" MinHeight="28" />
                                    <Button Margin="0,10,0,0" Command="{Binding CustomScanCommand}" Style="{DynamicResource Style.ButtonSecondary}" Height="30" HorizontalAlignment="Stretch">
                                        <TextBlock Text="{loc:Loc scan.select_folder}" FontSize="11" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- CARD C: Active Tasks (parallel scans, one row per running task) -->
                <Border Margin="0,11,0,0" Style="{DynamicResource Style.Card}" Padding="12"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,7,0" VerticalAlignment="Center"
                                     Fill="{DynamicResource Brush.Success}" />
                            <TextBlock Text="{Binding ActiveTasksHeaderText}" Style="{DynamicResource Style.SectionLabel}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding ActiveTasks}" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{DynamicResource Style.CardQuiet}" Padding="11" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Orientation="Horizontal" Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource Brush.Success}" VerticalAlignment="Center" />
                                                        <TextBlock Text="{loc:Loc tasks.running}" FontSize="10" FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Brush.Success}" Margin="5,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource Brush.TextPrimary}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ThreatsFound, StringFormat={}{0:N0}}" Margin="10,0,0,0"
                                                               FontSize="11" FontWeight="SemiBold">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Foreground" Value="{DynamicResource Brush.Success}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ThreatsFound}" Value="0">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                                <TextBlock Text="{Binding ProgressText}" Style="{DynamicResource Style.MutedText}" FontSize="10" Margin="0,3,0,0"
                                                           TextTrimming="CharacterEllipsis" />
                                                <ProgressBar Height="6" Minimum="0" Maximum="100" Margin="0,8,0,0"
                                                             Value="{Binding Percent, Mode=OneWay}"
                                                             Style="{DynamicResource Style.ProgressBar}" />
                                                <TextBlock Text="{Binding CurrentFile}" FontFamily="Consolas" FontSize="10" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource Brush.TextMuted}" TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding CurrentFile}" />
                                            </StackPanel>
                                            <Button Grid.Column="1" Command="{Binding DataContext.CancelTaskCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}" Margin="14,0,0,0" VerticalAlignment="Top"
                                                    Style="{DynamicResource Style.ButtonSecondary}" Height="30" Padding="10,5"
                                                    Visibility="{Binding IsCancellable, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <Path Width="10" Height="10" Stroke="{DynamicResource Brush.Danger}" StrokeThickness="1.8"
                                                          Data="{DynamicResource Icon.Close}" Margin="0,0,5,0" Stretch="Uniform" />
                                                    <TextBlock Text="{loc:Loc scan.cancel_scan}" Foreground="{DynamicResource Brush.Danger}" FontSize="10" FontWeight="SemiBold" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- MODE 2: Scan Results DataGrid Table Panel -->
        <Grid Visibility="{Binding IsShowingScanResults, Converter={StaticResource BoolToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header & Action Buttons -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,16,0">
                    <TextBlock Text="{Binding ScanResultsTitle}" Style="{DynamicResource Style.SectionLabel}" />
                    <TextBlock Text="{Binding ScanResultsSummaryText}" Margin="0,4,0,0" Style="{DynamicResource Style.CardTitle}" />
                </StackPanel>
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Command="{Binding BackToScanCommand}" Style="{DynamicResource Style.ButtonSecondary}" Height="34" Padding="12,6" Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="11" Height="11" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5" Data="{DynamicResource Icon.ChevronRight}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform Angle="180" />
                                </Path.RenderTransform>
                            </Path>
                            <TextBlock Text="{loc:Loc scan.results_back}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ApplyScanActionsCommand}" Style="{DynamicResource Style.ButtonPrimary}" Height="34" Padding="14,6">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="12" Height="12" Stroke="{DynamicResource Brush.PrimaryContent}" StrokeThickness="1.5" Data="{DynamicResource Icon.Check}" Stretch="Uniform" />
                            <TextBlock Text="{loc:Loc scan.results_apply}" Margin="6,0,0,0" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
            </Grid>

            <!-- DataGrid Panel -->
            <Border Grid.Row="2" Style="{DynamicResource Style.Card}" Padding="0" ClipToBounds="True">
                <Grid MinHeight="250">
                    <DataGrid x:Name="ScanResultsGrid" ItemsSource="{Binding CurrentScanResults}"
                              SelectedItem="{Binding SelectedScanResult, Mode=TwoWay}"
                              Style="{DynamicResource Style.DataTable}">
                        <DataGrid.Columns>
                            <!-- File Path Column -->
                            <DataGridTemplateColumn Width="*" MinWidth="220" SortMemberPath="FilePath">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="{loc:Loc scan.col_file}" /></DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center" Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Path Width="13" Height="13" Margin="0,2,8,0" VerticalAlignment="Top"
                                                  Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.4"
                                                  Data="{DynamicResource Icon.File}" Stretch="Uniform" />
                                            <TextBlock Grid.Column="1" Text="{Binding FilePath}" VerticalAlignment="Center"
                                                       Foreground="{DynamicResource Brush.TextPrimary}"
                                                       FontSize="11.5" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                       ToolTip="{Binding FilePath}" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Verdict Column -->
                            <DataGridTemplateColumn Width="145">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="{loc:Loc scan.col_verdict}" /></DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="9,4" CornerRadius="6" HorizontalAlignment="Left" VerticalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="{x:Static core:ScanVerdict.Clean}">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="{x:Static core:ScanVerdict.Trusted}">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Success}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="{x:Static core:ScanVerdict.Malicious}">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="{x:Static core:ScanVerdict.PotentiallyUnwanted}">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Verdict}" Value="{x:Static core:ScanVerdict.StrongIndicator}">
                                                            <Setter Property="Background" Value="{DynamicResource Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.PrimaryContent}" TextTrimming="CharacterEllipsis">
                                                <TextBlock.Text>
                                                    <MultiBinding Converter="{StaticResource VerdictTextConverter}">
                                                        <Binding Path="Verdict" />
                                                        <Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Threat Detection Name Column -->
                            <DataGridTextColumn Width="170" Binding="{Binding ThreatName}" ElementStyle="{StaticResource Style.GridColumnText}">
                                <DataGridTextColumn.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="{loc:Loc scan.col_threat}" /></DataTemplate>
                                </DataGridTextColumn.HeaderTemplate>
                            </DataGridTextColumn>

                            <!-- Mitigation Action ComboBox Column -->
                            <DataGridTemplateColumn Width="160">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="{loc:Loc scan.col_action}" /></DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <ComboBox Style="{DynamicResource Style.ComboBox}" ItemContainerStyle="{DynamicResource Style.ComboBoxItem}"
                                                  SelectedValue="{Binding SelectedAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding IsThreat}"
                                                  Height="30" Padding="8,2" VerticalAlignment="Center" Margin="0,2">
                                            <models:ThreatResolutionAction>Quarantine</models:ThreatResolutionAction>
                                            <models:ThreatResolutionAction>Delete</models:ThreatResolutionAction>
                                            <models:ThreatResolutionAction>Ignore</models:ThreatResolutionAction>
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Converter={StaticResource ActionTextConverter}}" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Status Column -->
                            <DataGridTemplateColumn Width="120">
                                <DataGridTemplateColumn.HeaderTemplate>
                                    <DataTemplate><TextBlock Text="{loc:Loc scan.col_status}" /></DataTemplate>
                                </DataGridTemplateColumn.HeaderTemplate>
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Status}" VerticalAlignment="Center"
                                                   FontSize="11.5" FontWeight="Normal"
                                                   Foreground="{DynamicResource Brush.TextSecondary}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Empty state -->
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CurrentScanResults.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Border Width="44" Height="44" Background="{DynamicResource Brush.SurfaceSubtle}" HorizontalAlignment="Center">
                            <Path Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5" Data="{DynamicResource Icon.Scan}" />
                        </Border>
                        <TextBlock Text="{loc:Loc scan.results_empty}" Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Bottom Detail Panel -->
            <Border Grid.Row="4" Style="{DynamicResource Style.CardQuiet}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc scan.col_file}" Style="{DynamicResource Style.SectionLabel}" />
                        <TextBlock Text="{Binding SelectedScanResult.FilePath, FallbackValue='...'}" Margin="0,4,0,0" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
