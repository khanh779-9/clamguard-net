<UserControl x:Class="ClamGuard.Antivirus.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <StackPanel>
            <Border Style="{DynamicResource Style.CardEmphasis}" Padding="14">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="42" Height="42" Background="{DynamicResource Brush.PrimarySoft}"><Path Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.5" Data="{DynamicResource Icon.Security}" Stretch="Uniform" /></Border>
                    <StackPanel Grid.Column="1" Margin="13,0,18,0" VerticalAlignment="Center"><TextBlock Text="{loc:Loc security.realtime_title}" Style="{DynamicResource Style.CardTitle}" FontSize="16" /><TextBlock Text="{loc:Loc security.realtime_desc}" Margin="0,4,0,0" Style="{DynamicResource Style.MutedText}" /></StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RealtimeStatusText}" Style="{DynamicResource Style.RealtimeStateText}" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" />
                        <CheckBox Margin="0,7,0,0" IsChecked="{Binding RealtimeEnabled}" Command="{Binding RealtimeToggleCommand}" Style="{DynamicResource Style.ToggleSwitch}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Padding="14">
                    <StackPanel><TextBlock Text="{loc:Loc security.monitored_folder}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{Binding RealtimePath}" Margin="0,7,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" /><TextBlock Text="{loc:Loc security.folder_desc}" Margin="0,7,0,12" Style="{DynamicResource Style.MutedText}" /><Button Command="{Binding RealtimeFolderCommand}" Style="{DynamicResource Style.ButtonSecondary}" HorizontalAlignment="Left"><TextBlock Text="{loc:Loc security.choose_folder}" /></Button></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{DynamicResource Style.Card}" Padding="14">
                    <StackPanel><TextBlock Text="{loc:Loc security.protection_data}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{Binding DatabaseSummary}" Margin="0,7,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" /><TextBlock Text="{loc:Loc security.protection_data_desc}" Margin="0,7,0,12" Style="{DynamicResource Style.MutedText}" /><Button Command="{Binding UpdateCommand}" Style="{DynamicResource Style.ButtonSecondary}" HorizontalAlignment="Left"><TextBlock Text="{loc:Loc security.update_signatures}" /></Button></StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,14,0,0" Style="{DynamicResource Style.CardQuiet}" Padding="13">
                <StackPanel Orientation="Horizontal"><Path Width="15" Height="15" Margin="0,1,9,0" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5" Data="{DynamicResource Icon.Info}" /><TextBlock Text="{loc:Loc security.realtime_hint}" Style="{DynamicResource Style.MutedText}" /></StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
