<UserControl x:Class="ClamGuard.Antivirus.Views.SecurityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <StackPanel>
            <Border Style="{DynamicResource Style.CardEmphasis}" Padding="12">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="38" Height="38" Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="8"><Path Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.5" Data="{DynamicResource Icon.Security}" Stretch="Uniform" /></Border>
                    <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center"><TextBlock Text="{loc:Loc security.realtime_title}" Style="{DynamicResource Style.CardTitle}" FontSize="15" /><TextBlock Text="{loc:Loc security.realtime_desc}" Margin="0,3,0,0" Style="{DynamicResource Style.MutedText}" /></StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding RealtimeStatusText}" Style="{DynamicResource Style.RealtimeStateText}" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" />
                        <CheckBox Margin="0,6,0,0" IsChecked="{Binding RealtimeEnabled}" Command="{Binding RealtimeToggleCommand}" Style="{DynamicResource Style.ToggleSwitch}" HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,11,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc security.monitored_folder}" Style="{DynamicResource Style.SectionLabel}" />
                        <TextBlock Text="{Binding RealtimePath}" Margin="0,5,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Loc security.folder_desc}" Margin="0,5,0,10" Style="{DynamicResource Style.MutedText}" />
                        <Button Command="{Binding RealtimeFolderCommand}" Style="{DynamicResource Style.ButtonSecondary}" Height="32" Padding="14,6" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13" Height="13" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5" Data="{DynamicResource Icon.Folder}" Stretch="Uniform" />
                                <TextBlock Text="{loc:Loc security.choose_folder}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{DynamicResource Style.Card}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc security.protection_data}" Style="{DynamicResource Style.SectionLabel}" />
                        <TextBlock Text="{Binding DatabaseSummary}" Margin="0,5,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:Loc security.protection_data_desc}" Margin="0,5,0,10" Style="{DynamicResource Style.MutedText}" />
                        <Button Command="{Binding UpdateCommand}" Style="{DynamicResource Style.ButtonSecondary}" Height="32" Padding="14,6" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13" Height="13" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5" Data="{DynamicResource Icon.Update}" Stretch="Uniform" />
                                <TextBlock Text="{loc:Loc security.update_signatures}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,11,0,0" Style="{DynamicResource Style.CardQuiet}" Padding="10">
                <StackPanel Orientation="Horizontal"><Path Width="14" Height="14" Margin="0,1,8,0" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5" Data="{DynamicResource Icon.Info}" /><TextBlock Text="{loc:Loc security.realtime_hint}" Style="{DynamicResource Style.MutedText}" /></StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
