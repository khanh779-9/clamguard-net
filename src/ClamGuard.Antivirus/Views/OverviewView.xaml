<UserControl x:Class="ClamGuard.Antivirus.Views.OverviewView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization"
             xmlns:controls="clr-namespace:ClamGuard.Antivirus.Controls"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <StackPanel>
            <Border Style="{DynamicResource Style.CardEmphasis}" Padding="16">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="64" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Border Width="56" Height="56" Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="14">
                        <Path Width="30" Height="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource Brush.Primary}" Stretch="Uniform" Data="{DynamicResource Icon.AppLogo}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,18,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc overview.protection_status}" Style="{DynamicResource Style.SectionLabel}" />
                        <TextBlock Text="{Binding StatusTitle}" Margin="0,5,0,0" FontSize="19" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StatusDescription}" Margin="0,6,0,0" Style="{DynamicResource Style.BodyText}" MaxWidth="620" />
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <TextBlock Text="{Binding LastUpdateText, StringFormat={}{0}}" Style="{DynamicResource Style.MutedText}" />
                            <TextBlock Text="  Â·  " Style="{DynamicResource Style.MutedText}" />
                            <TextBlock Text="{Binding SignatureCount, StringFormat={}{0:N0}}" Style="{DynamicResource Style.MutedText}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Border Style="{DynamicResource Style.ReadyBadge}" BorderThickness="1" Padding="9,5">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" VerticalAlignment="Center" Style="{DynamicResource Style.ReadyDot}" />
                                <TextBlock Text="{Binding DatabaseStatusText}" Style="{DynamicResource Style.ReadyText}" FontSize="10" FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Button Margin="0,10,0,0" Command="{Binding QuickScanCommand}" Style="{DynamicResource Style.ButtonPrimary}"
                                MinWidth="124">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="14" Height="14" Margin="0,0,7,0" Stroke="{DynamicResource Brush.PrimaryContent}" StrokeThickness="1.5"
                                      Stretch="Uniform" Data="{DynamicResource Icon.Scan}" />
                                <TextBlock Text="{loc:Loc overview.quick_scan}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Padding="13"><StackPanel><TextBlock Text="{loc:Loc overview.scan_records}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{Binding TotalReports}" Style="{DynamicResource Style.MetricValue}" /><TextBlock Text="{loc:Loc overview.recent_scans}" Style="{DynamicResource Style.MetricLabel}" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{DynamicResource Style.Card}" Padding="13"><StackPanel><TextBlock Text="{loc:Loc overview.threats}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{Binding ThreatReports}" Style="{DynamicResource Style.MetricValue}" Foreground="{DynamicResource Brush.Danger}" /><TextBlock Text="{loc:Loc overview.detected_history}" Style="{DynamicResource Style.MetricLabel}" /></StackPanel></Border>
                <Border Grid.Column="4" Style="{DynamicResource Style.Card}" Padding="13"><StackPanel><TextBlock Text="{loc:Loc overview.signatures}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{Binding SignatureCount, StringFormat={}{0:N0}}" Style="{DynamicResource Style.MetricValue}" /><TextBlock Text="{loc:Loc overview.loaded_engine}" Style="{DynamicResource Style.MetricLabel}" /></StackPanel></Border>
            </Grid>

            <TextBlock Text="{loc:Loc overview.quick_actions}" Margin="2,18,0,9" Style="{DynamicResource Style.SectionLabel}" />
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Padding="13">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="{DynamicResource Brush.PrimarySoft}"><Path Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Brush.Primary}" StrokeThickness="1.6" Stretch="Uniform" Data="{DynamicResource Icon.Scan}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"><TextBlock Text="{loc:Loc overview.scan_file}" Style="{DynamicResource Style.CardTitle}" /><TextBlock Text="{loc:Loc overview.scan_file_desc}" Margin="0,3,0,0" Style="{DynamicResource Style.MutedText}" /></StackPanel>
                        <Button Grid.Column="2" Command="{Binding QuickScanCommand}" Style="{DynamicResource Style.ButtonGhost}"><TextBlock Text="{loc:Loc overview.start}" /></Button>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{DynamicResource Style.Card}" Padding="13">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="{DynamicResource Brush.SurfaceSubtle}"><Path Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.6" Stretch="Uniform" Data="{DynamicResource Icon.Folder}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"><TextBlock Text="{loc:Loc overview.scan_folder}" Style="{DynamicResource Style.CardTitle}" /><TextBlock Text="{loc:Loc overview.scan_folder_desc}" Margin="0,3,0,0" Style="{DynamicResource Style.MutedText}" /></StackPanel>
                        <Button Grid.Column="2" Command="{Binding CustomScanCommand}" Style="{DynamicResource Style.ButtonGhost}"><TextBlock Text="{loc:Loc overview.choose}" /></Button>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="0" Style="{DynamicResource Style.Card}" Padding="13">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="{DynamicResource Brush.SuccessSoft}"><Path Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.5" Stretch="Uniform" Data="{DynamicResource Icon.Update}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"><TextBlock Text="{loc:Loc overview.update}" Style="{DynamicResource Style.CardTitle}" /><TextBlock Text="{loc:Loc overview.update_desc}" Margin="0,3,0,0" Style="{DynamicResource Style.MutedText}" /></StackPanel>
                        <Button Grid.Column="2" Command="{Binding UpdateCommand}" Style="{DynamicResource Style.ButtonGhost}"><TextBlock Text="{loc:Loc overview.check}" /></Button>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Grid.Column="2" Style="{DynamicResource Style.Card}" Padding="13">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="42" Height="42" Background="{DynamicResource Brush.WarningSoft}"><Path Width="20" Height="20" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Brush.Warning}" StrokeThickness="1.5" Stretch="Uniform" Data="{DynamicResource Icon.Security}" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,12,0" VerticalAlignment="Center"><TextBlock Text="{loc:Loc overview.realtime}" Style="{DynamicResource Style.CardTitle}" /><TextBlock Text="{loc:Loc overview.realtime_desc}" Margin="0,3,0,0" Style="{DynamicResource Style.MutedText}" /></StackPanel>
                        <Button Grid.Column="2" Command="{Binding ConfigureSecurityCommand}" Style="{DynamicResource Style.ButtonGhost}"><TextBlock Text="{loc:Loc overview.open}" /></Button>
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
    </Grid>
</UserControl>
