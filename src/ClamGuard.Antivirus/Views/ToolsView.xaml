<UserControl x:Class="ClamGuard.Antivirus.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Padding="16"><StackPanel><TextBlock Text="{loc:Loc tools.engine_status}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{Binding DatabaseStatusText}" Style="{DynamicResource Style.ToolsReadyMetric}" /><TextBlock Text="{loc:Loc tools.scanner}" Style="{DynamicResource Style.MetricLabel}" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{DynamicResource Style.Card}" Padding="16"><StackPanel><TextBlock Text="{loc:Loc tools.database_version}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{Binding DatabaseVersion, TargetNullValue=—}" Style="{DynamicResource Style.MetricValue}" /><TextBlock Text="{loc:Loc tools.loaded_generation}" Style="{DynamicResource Style.MetricLabel}" /></StackPanel></Border>
            </Grid>

            <Border Margin="0,12,0,0" Style="{DynamicResource Style.Card}" Padding="18">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock Text="{loc:Loc tools.protection_data}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{Binding DatabaseSummary}" Margin="0,6,0,0" Style="{DynamicResource Style.CardTitle}" /><TextBlock Text="{Binding DatabasePath}" Margin="0,5,0,0" Style="{DynamicResource Style.MutedText}" TextTrimming="CharacterEllipsis" /></StackPanel>
                    <Button Grid.Column="1" Command="{Binding UpdateCommand}" Style="{DynamicResource Style.ButtonPrimary}" VerticalAlignment="Center"><TextBlock Text="{loc:Loc tools.update_now}" /></Button>
                </Grid>
            </Border>

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Padding="18">
                    <StackPanel><TextBlock Text="{loc:Loc tools.file_inspector}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{loc:Loc tools.file_inspector_desc}" Margin="0,5,0,12" Style="{DynamicResource Style.MutedText}" /><Button Command="{Binding InspectFileCommand}" Style="{DynamicResource Style.ButtonSecondary}" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><Path Width="15" Height="15" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.4" Data="{DynamicResource Icon.Hash}" Stretch="Uniform" /><TextBlock Text="{loc:Loc tools.inspect_file}" Margin="7,0,0,0" /></StackPanel></Button></StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{DynamicResource Style.Card}" Padding="18">
                    <StackPanel><TextBlock Text="{loc:Loc tools.system_profile}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{loc:Loc tools.system_profile_desc}" Margin="0,5,0,12" Style="{DynamicResource Style.MutedText}" /><StackPanel Orientation="Horizontal"><Button Command="{Binding RefreshSystemCommand}" Style="{DynamicResource Style.ButtonSecondary}" IsEnabled="{Binding IsSystemBusy, Converter={StaticResource InverseBoolConverter}}"><TextBlock Text="{loc:Loc tools.refresh}" /></Button><Button Margin="8,0,0,0" Command="{Binding OpenWindowsSecurityCommand}" Style="{DynamicResource Style.ButtonGhost}"><TextBlock Text="{loc:Loc tools.open_security}" /></Button></StackPanel></StackPanel>
                </Border>
            </Grid>

            <Border Margin="0,12,0,0" Style="{DynamicResource Style.Card}" Padding="0" ClipToBounds="True">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                    <Border Background="{DynamicResource Brush.SurfaceSubtle}" BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,0,1" Padding="12"><TextBlock Text="{loc:Loc tools.file_inspector}" Style="{DynamicResource Style.SectionLabel}" /></Border>
                    <Grid Grid.Row="1" Margin="14" MinHeight="130">
                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="110" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <TextBlock Text="{loc:Loc tools.path}" Style="{DynamicResource Style.MutedText}" /><TextBlock Grid.Column="1" Text="{Binding InspectedFile.Path, TargetNullValue=—}" Style="{DynamicResource Style.GridColumnText}" />
                        <TextBlock Grid.Row="1" Text="{loc:Loc tools.sha256}" Style="{DynamicResource Style.MutedText}" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding InspectedFile.Sha256, TargetNullValue=—}" FontFamily="Consolas" FontSize="9.5" Foreground="{DynamicResource Brush.TextSecondary}" TextWrapping="Wrap" />
                        <TextBlock Grid.Row="2" Text="{loc:Loc tools.version}" Style="{DynamicResource Style.MutedText}" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding InspectedFile.Version, TargetNullValue=—}" Style="{DynamicResource Style.GridColumnText}" />
                        <TextBlock Grid.Row="3" Text="{loc:Loc tools.signature}" Style="{DynamicResource Style.MutedText}" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding InspectedFile.SignatureStatus, TargetNullValue=—}" Style="{DynamicResource Style.GridColumnText}" />
                    </Grid>
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
