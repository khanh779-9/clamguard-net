<UserControl x:Class="ClamGuard.Antivirus.Views.SettingsView"
              xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
              xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization"
              UseLayoutRounding="True" SnapsToDevicePixels="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <StackPanel>
            <!-- Appearance / Theme -->
            <Border Style="{DynamicResource Style.Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.appearance}" Style="{DynamicResource Style.SectionLabel}" />
                    <TextBlock Text="{loc:Loc settings.theme}" Margin="0,4,0,0" Style="{DynamicResource Style.CardTitle}" />
                    <TextBlock Text="{loc:Loc settings.theme_desc}" Margin="0,3,0,10" Style="{DynamicResource Style.MutedText}" TextWrapping="Wrap" />
                    <ComboBox x:Name="ThemeComboBox" Style="{DynamicResource Style.ComboBox}" ItemContainerStyle="{DynamicResource Style.ComboBoxItem}"
                              SelectedValue="{Binding Theme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Height="34">
                        <ComboBoxItem Content="{loc:Loc settings.dark}" Tag="Dark" />
                        <ComboBoxItem Content="{loc:Loc settings.light}" Tag="Light" />
                        <ComboBoxItem Content="{loc:Loc settings.auto}" Tag="Auto" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Language -->
            <Border Margin="0,10,0,0" Style="{DynamicResource Style.Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.language}" Style="{DynamicResource Style.SectionLabel}" />
                    <TextBlock Text="{loc:Loc settings.language_desc}" Margin="0,4,0,10" Style="{DynamicResource Style.MutedText}" TextWrapping="Wrap" />
                    <ComboBox x:Name="LanguageComboBox" Style="{DynamicResource Style.ComboBox}" ItemContainerStyle="{DynamicResource Style.ComboBoxItem}"
                              SelectedValue="{Binding Language, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Height="34">
                        <ComboBoxItem Content="{loc:Loc settings.english}" Tag="en-US" />
                        <ComboBoxItem Content="{loc:Loc settings.vietnamese}" Tag="vi-VN" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <!-- Threat Mitigation Policy -->
            <Border Margin="0,10,0,0" Style="{DynamicResource Style.Card}" Padding="12">
                <StackPanel>
                    <TextBlock Text="{loc:Loc settings.actions_title}" Style="{DynamicResource Style.SectionLabel}" />
                    <TextBlock Text="{loc:Loc settings.actions_desc}" Margin="0,3,0,11" Style="{DynamicResource Style.MutedText}" TextWrapping="Wrap" />

                    <!-- On-Demand Scan Default Action -->
                    <TextBlock Text="{loc:Loc settings.scan_action}" Style="{DynamicResource Style.CardTitle}" FontSize="12" />
                    <TextBlock Text="{loc:Loc settings.scan_action_desc}" Margin="0,2,0,6" Style="{DynamicResource Style.MutedText}" TextWrapping="Wrap" />
                    <ComboBox Style="{DynamicResource Style.ComboBox}" ItemContainerStyle="{DynamicResource Style.ComboBoxItem}"
                              SelectedValue="{Binding ScanThreatAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Height="34" Margin="0,0,0,11">
                        <ComboBoxItem Content="{loc:Loc settings.action_manual}" Tag="Manual" />
                        <ComboBoxItem Content="{loc:Loc settings.action_quarantine}" Tag="Quarantine" />
                        <ComboBoxItem Content="{loc:Loc settings.action_delete}" Tag="Delete" />
                        <ComboBoxItem Content="{loc:Loc settings.action_ignore}" Tag="Ignore" />
                    </ComboBox>

                    <!-- Real-time Protection Default Action -->
                    <TextBlock Text="{loc:Loc settings.realtime_action}" Style="{DynamicResource Style.CardTitle}" FontSize="12" />
                    <TextBlock Text="{loc:Loc settings.realtime_action_desc}" Margin="0,2,0,6" Style="{DynamicResource Style.MutedText}" TextWrapping="Wrap" />
                    <ComboBox Style="{DynamicResource Style.ComboBox}" ItemContainerStyle="{DynamicResource Style.ComboBoxItem}"
                              SelectedValue="{Binding RealtimeThreatAction, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" SelectedValuePath="Tag" Height="34">
                        <ComboBoxItem Content="{loc:Loc settings.action_quarantine}" Tag="Quarantine" />
                        <ComboBoxItem Content="{loc:Loc settings.action_delete}" Tag="Delete" />
                        <ComboBoxItem Content="{loc:Loc settings.action_ignore}" Tag="Ignore" />
                    </ComboBox>
                </StackPanel>
            </Border>

            <Border Margin="0,10,0,0" Style="{DynamicResource Style.CardQuiet}" Padding="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Path Width="15" Height="15" Margin="0,1,9,0"
                          VerticalAlignment="Top"
                          Stroke="{DynamicResource Brush.TextSecondary}"
                          StrokeThickness="1.4"
                          Data="{DynamicResource Icon.Info}" />
                    <TextBlock Grid.Column="1"
                               Text="{loc:Loc settings.stored}"
                               Style="{DynamicResource Style.MutedText}"
                               TextWrapping="Wrap" />
                </Grid>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
