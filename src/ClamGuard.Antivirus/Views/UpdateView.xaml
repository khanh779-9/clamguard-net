<UserControl x:Class="ClamGuard.Antivirus.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization"
             xmlns:controls="clr-namespace:ClamGuard.Antivirus.Controls"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>
                <Border Style="{DynamicResource Style.CardEmphasis}" Padding="13">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="44" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" Background="{DynamicResource Brush.SuccessSoft}" CornerRadius="8"><Path Width="19" Height="19" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.5" Data="{DynamicResource Icon.Update}" Stretch="Uniform" /></Border>
                        <StackPanel Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center"><TextBlock Text="{loc:Loc update.database}" Style="{DynamicResource Style.CardTitle}" FontSize="15" /><TextBlock Text="{loc:Loc update.keep_current}" Margin="0,3,0,0" Style="{DynamicResource Style.MutedText}" /><TextBlock Text="{Binding DatabaseSummary}" Margin="0,6,0,0" Style="{DynamicResource Style.BodyText}" /></StackPanel>
                        <Button Grid.Column="2" Command="{Binding UpdateCommand}" Style="{DynamicResource Style.ButtonPrimary}" Height="34" Padding="15,6" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13" Height="13" Stroke="{DynamicResource Brush.PrimaryContent}" StrokeThickness="1.5" Data="{DynamicResource Icon.Update}" Stretch="Uniform" />
                                <TextBlock Text="{loc:Loc update.update_now}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Border Margin="0,11,0,0" Style="{DynamicResource Style.Card}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc update.local_location}" Style="{DynamicResource Style.SectionLabel}" />
                        <TextBlock Text="{loc:Loc update.location_desc}" Margin="0,4,0,8" Style="{DynamicResource Style.MutedText}" />
                        <Border Style="{DynamicResource Style.CardQuiet}" Padding="9">
                            <TextBlock Text="{Binding DatabasePath, FallbackValue='C:\\ProgramData\\ClamGuard\\database', TargetNullValue='C:\\ProgramData\\ClamGuard\\database'}"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource Brush.TextSecondary}"
                                       TextTrimming="CharacterEllipsis"
                                       ToolTip="{Binding DatabasePath}" />
                        </Border>
                        <Button Command="{Binding ChangeDataLocationCommand}" Margin="0,8,0,0" Style="{DynamicResource Style.ButtonSecondary}" Height="32" Padding="14,6" HorizontalAlignment="Left" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="13" Height="13" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5" Data="{DynamicResource Icon.Folder}" Stretch="Uniform" />
                                <TextBlock Text="{loc:Loc update.change_location}" Margin="7,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Margin="0,11,0,0" Style="{DynamicResource Style.CardQuiet}" Padding="10">
                    <StackPanel Orientation="Horizontal"><Path Width="14" Height="14" Margin="0,1,8,0" Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.5" Data="{DynamicResource Icon.CheckCircle}" /><StackPanel><TextBlock Text="{loc:Loc update.verified}" Style="{DynamicResource Style.CardTitle}" FontSize="11" /><TextBlock Text="{loc:Loc update.busy_note}" Margin="0,2,0,0" Style="{DynamicResource Style.MutedText}" /></StackPanel></StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
