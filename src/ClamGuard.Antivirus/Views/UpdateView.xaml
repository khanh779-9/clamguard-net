<UserControl x:Class="ClamGuard.Antivirus.Views.UpdateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization"
             xmlns:controls="clr-namespace:ClamGuard.Antivirus.Controls"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
            <StackPanel>
                <Border Style="{DynamicResource Style.CardEmphasis}" Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="48" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" Background="{DynamicResource Brush.SuccessSoft}"><Path Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.5" Data="{DynamicResource Icon.Update}" Stretch="Uniform" /></Border>
                        <StackPanel Grid.Column="1" Margin="14,0,18,0" VerticalAlignment="Center"><TextBlock Text="{loc:Loc update.database}" Style="{DynamicResource Style.CardTitle}" FontSize="16" /><TextBlock Text="{loc:Loc update.keep_current}" Margin="0,4,0,0" Style="{DynamicResource Style.MutedText}" /><TextBlock Text="{Binding DatabaseSummary}" Margin="0,8,0,0" Style="{DynamicResource Style.BodyText}" /></StackPanel>
                        <Button Grid.Column="2" Command="{Binding UpdateCommand}" Style="{DynamicResource Style.ButtonPrimary}" VerticalAlignment="Center"><TextBlock Text="{loc:Loc update.update_now}" /></Button>
                    </Grid>
                </Border>

                <Border Margin="0,14,0,0" Style="{DynamicResource Style.Card}" Padding="14">
                    <StackPanel><TextBlock Text="{loc:Loc update.local_location}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{loc:Loc update.location_desc}" Margin="0,5,0,10" Style="{DynamicResource Style.MutedText}" /><Border Style="{DynamicResource Style.CardQuiet}" Padding="11"><TextBlock Text="{Binding DatabasePath}" FontSize="10.5" Foreground="{DynamicResource Brush.TextSecondary}" TextTrimming="CharacterEllipsis" /></Border><Button Command="{Binding ChangeDataLocationCommand}" Margin="0,10,0,0" Style="{DynamicResource Style.ButtonSecondary}" HorizontalAlignment="Left" IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"><TextBlock Text="{loc:Loc update.change_location}" /></Button></StackPanel>
                </Border>

                <Border Margin="0,14,0,0" Style="{DynamicResource Style.CardQuiet}" Padding="13">
                    <StackPanel Orientation="Horizontal"><Path Width="15" Height="15" Margin="0,1,9,0" Stroke="{DynamicResource Brush.Success}" StrokeThickness="1.5" Data="{DynamicResource Icon.CheckCircle}" /><StackPanel><TextBlock Text="{loc:Loc update.verified}" Style="{DynamicResource Style.CardTitle}" FontSize="11" /><TextBlock Text="{loc:Loc update.busy_note}" Margin="0,2,0,0" Style="{DynamicResource Style.MutedText}" /></StackPanel></StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
