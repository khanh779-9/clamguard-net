<UserControl x:Class="ClamGuard.Antivirus.Views.SystemView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Style="{DynamicResource Style.Card}" Padding="13">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{loc:Loc system.profile}" Style="{DynamicResource Style.SectionLabel}" />
                        <TextBlock Text="{Binding SystemOperatingSystem}" Margin="0,5,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding SystemArchitecture}" Margin="0,4,0,0" Style="{DynamicResource Style.MutedText}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <TextBlock Text="{loc:Loc system.privilege}" Style="{DynamicResource Style.SectionLabel}" HorizontalAlignment="Right" />
                        <TextBlock Text="{Binding SystemPrivilegeText}" Margin="0,4,0,8" FontSize="10.5" FontWeight="SemiBold" Style="{DynamicResource Style.PrivilegeText}" HorizontalAlignment="Right" />
                        <Button Command="{Binding RefreshSystemCommand}" Style="{DynamicResource Style.ButtonSecondary}" IsEnabled="{Binding IsSystemBusy, Converter={StaticResource InverseBoolConverter}}" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal"><Path Width="13" Height="13" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.4" Data="{DynamicResource Icon.Refresh}" Stretch="Uniform" /><TextBlock Text="{loc:Loc system.refresh}" Margin="7,0,0,0" /></StackPanel>
                    </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" /><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Style="{DynamicResource Style.Card}" Padding="12"><StackPanel><TextBlock Text="{loc:Loc system.cpu}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{Binding SystemLogicalProcessors}" Style="{DynamicResource Style.MetricValue}" /><TextBlock Text="{loc:Loc common.logical}" Style="{DynamicResource Style.MetricLabel}" /></StackPanel></Border>
                <Border Grid.Column="2" Style="{DynamicResource Style.Card}" Padding="12"><StackPanel><TextBlock Text="{loc:Loc system.memory}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{Binding SystemMemoryText}" Style="{DynamicResource Style.MetricValue}" /><TextBlock Text="{loc:Loc common.available_total}" Style="{DynamicResource Style.MetricLabel}" /></StackPanel></Border>
                <Border Grid.Column="4" Style="{DynamicResource Style.Card}" Padding="12"><StackPanel><TextBlock Text="{loc:Loc system.uptime}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{Binding SystemUptimeText}" Style="{DynamicResource Style.MetricValue}" /><TextBlock Text="{loc:Loc common.since_boot}" Style="{DynamicResource Style.MetricLabel}" /></StackPanel></Border>
                <Border Grid.Column="6" Style="{DynamicResource Style.Card}" Padding="12"><StackPanel><TextBlock Text="{loc:Loc system.storage}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{Binding Drives.Count}" Style="{DynamicResource Style.MetricValue}" /><TextBlock Text="{loc:Loc common.mounted_volumes}" Style="{DynamicResource Style.MetricLabel}" /></StackPanel></Border>
            </Grid>

            <Border Grid.Row="4" Style="{DynamicResource Style.Card}" Padding="0" ClipToBounds="True">
                <StackPanel>
                    <Grid Margin="12,12,12,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock Text="{loc:Loc system.processes}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Grid.Column="1" Text="{loc:Loc system.process_limit}" Foreground="{DynamicResource Brush.TextMuted}" FontSize="10" /></Grid>
                    <DataGrid ItemsSource="{Binding RunningProcesses}" Style="{DynamicResource Style.DataTable}" MaxHeight="265">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="*" Binding="{Binding Name}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.name}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                            <DataGridTextColumn Width="80" Binding="{Binding Id}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.pid}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                            <DataGridTextColumn Width="110" Binding="{Binding MemoryMb, StringFormat={}{0:N1} MB}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.memory_column}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                            <DataGridTextColumn Width="*" Binding="{Binding WindowTitle}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.window}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                            <DataGridTextColumn Width="1.3*" Binding="{Binding ExecutablePath}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.executable}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Margin="0,12,0,0" Style="{DynamicResource Style.CardQuiet}" Padding="0" ClipToBounds="True">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc system.storage_details}" Style="{DynamicResource Style.SectionLabel}" Margin="12,12,12,8" />
                            <DataGrid ItemsSource="{Binding Drives}" Style="{DynamicResource Style.DataTable}" MaxHeight="190">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Width="80" Binding="{Binding Name}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.name}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                                    <DataGridTextColumn Width="*" Binding="{Binding Label}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.label}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                                    <DataGridTextColumn Width="110" Binding="{Binding UsedGb, StringFormat={}{0:N1} GB}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.used}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                                    <DataGridTextColumn Width="110" Binding="{Binding FreeGb, StringFormat={}{0:N1} GB}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.free}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                                    <DataGridTextColumn Width="110" Binding="{Binding TotalGb, StringFormat={}{0:N1} GB}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.total}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="10" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{DynamicResource Style.CardQuiet}" Padding="0" ClipToBounds="True">
                            <StackPanel><TextBlock Text="{loc:Loc system.network}" Style="{DynamicResource Style.SectionLabel}" Margin="12,12,12,8" />
                                <DataGrid ItemsSource="{Binding NetworkAdapters}" Style="{DynamicResource Style.DataTable}" MaxHeight="190">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="*" Binding="{Binding Name}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.name}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                                        <DataGridTextColumn Width="90" Binding="{Binding Type}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.type}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                                        <DataGridTextColumn Width="95" Binding="{Binding Status}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.status}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                                        <DataGridTextColumn Width="*" Binding="{Binding Addresses}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.address}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                        <Border Grid.Column="2" Style="{DynamicResource Style.CardQuiet}" Padding="0" ClipToBounds="True">
                            <StackPanel><TextBlock Text="{loc:Loc system.startup}" Style="{DynamicResource Style.SectionLabel}" Margin="12,12,12,8" />
                                <DataGrid ItemsSource="{Binding StartupItems}" Style="{DynamicResource Style.DataTable}" MaxHeight="190">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Width="*" Binding="{Binding Name}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.name}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                                        <DataGridTextColumn Width="90" Binding="{Binding Scope}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.scope}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                                        <DataGridTextColumn Width="*" Binding="{Binding Command}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc system.command}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
