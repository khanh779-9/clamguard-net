<UserControl x:Class="ClamGuard.Antivirus.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization"
             xmlns:core="clr-namespace:ClamGuard.Core;assembly=ClamGuard.Core"
             UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="*" /><RowDefinition Height="12" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0"><TextBlock Text="{loc:Loc history.title}" Style="{DynamicResource Style.SectionLabel}" /><TextBlock Text="{loc:Loc history.recent}" Margin="0,4,0,0" Style="{DynamicResource Style.CardTitle}" /></StackPanel>
            <WrapPanel Grid.Column="1" HorizontalAlignment="Right">
                <Button Command="{Binding DeleteHistoryCommand}" Style="{DynamicResource Style.ButtonSecondary}" Height="32" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{loc:Loc history.delete}" /></Button>
                <Button Command="{Binding ClearHistoryCommand}" Style="{DynamicResource Style.ButtonSecondary}" Height="32" Padding="10,5" Margin="0,0,8,0"><TextBlock Text="{loc:Loc history.clear_all}" /></Button>
                <Button Command="{Binding ExportHistoryCommand}" Style="{DynamicResource Style.ButtonSecondary}" Height="32" Padding="11,5"><StackPanel Orientation="Horizontal"><Path Width="12" Height="12" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.4" Stretch="Uniform" Data="{DynamicResource Icon.External}" /><TextBlock Text="{loc:Loc history.export}" Margin="6,0,0,0" /></StackPanel></Button>
            </WrapPanel>
        </Grid>

        <Border Grid.Row="2" Style="{DynamicResource Style.Card}" Padding="0" ClipToBounds="True">
            <Grid MinHeight="230">
                <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding RecentScans}" Style="{DynamicResource Style.DataTable}" SelectionChanged="HistoryGrid_SelectionChanged">
                    <DataGrid.Columns>
                        <DataGridTextColumn Width="130" Binding="{Binding Time, StringFormat='yyyy-MM-dd HH:mm'}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc history.time}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                        <DataGridTextColumn Width="110" Binding="{Binding Kind}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc history.type}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                        <DataGridTextColumn Width="*" Binding="{Binding FullPath}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc history.target}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                        <DataGridTextColumn Width="135" Binding="{Binding ProcessName}" ElementStyle="{StaticResource Style.GridColumnText}"><DataGridTextColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc history.process}" /></DataTemplate></DataGridTextColumn.HeaderTemplate></DataGridTextColumn>
                        <DataGridTemplateColumn Width="130">
                            <DataGridTemplateColumn.HeaderTemplate><DataTemplate><TextBlock Text="{loc:Loc history.result}" /></DataTemplate></DataGridTemplateColumn.HeaderTemplate><DataGridTemplateColumn.CellTemplate><DataTemplate><Border Padding="7,3" CornerRadius="4">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource Brush.Warning}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Verdict}" Value="{x:Static core:ScanVerdict.Clean}"><Setter Property="Background" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Verdict}" Value="{x:Static core:ScanVerdict.Trusted}"><Setter Property="Background" Value="{DynamicResource Brush.Success}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Verdict}" Value="{x:Static core:ScanVerdict.Malicious}"><Setter Property="Background" Value="{DynamicResource Brush.Danger}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Verdict}" Value="{x:Static core:ScanVerdict.PotentiallyUnwanted}"><Setter Property="Background" Value="{DynamicResource Brush.Danger}" /></DataTrigger>
                                            <DataTrigger Binding="{Binding Verdict}" Value="{x:Static core:ScanVerdict.StrongIndicator}"><Setter Property="Background" Value="{DynamicResource Brush.Danger}" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource Brush.PrimaryContent}" TextTrimming="CharacterEllipsis">
                                    <TextBlock.Text>
                                        <MultiBinding Converter="{StaticResource VerdictTextConverter}"><Binding Path="Verdict" /><Binding Path="DataContext.Language" RelativeSource="{RelativeSource AncestorType={x:Type UserControl}}" /></MultiBinding>
                                    </TextBlock.Text>
                                </TextBlock>
                            </Border></DataTemplate></DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasReports}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
                    <Border Width="44" Height="44" Background="{DynamicResource Brush.SurfaceSubtle}" HorizontalAlignment="Center"><Path Width="21" Height="21" HorizontalAlignment="Center" VerticalAlignment="Center" Stroke="{DynamicResource Brush.TextMuted}" StrokeThickness="1.5" Data="{DynamicResource Icon.History}" /></Border>
                    <TextBlock Text="{loc:Loc history.no_history}" Margin="0,10,0,0" HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Brush.TextPrimary}" />
                    <TextBlock Text="{loc:Loc history.run_scan}" Margin="0,4,0,0" HorizontalAlignment="Center" Style="{DynamicResource Style.MutedText}" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="4" Style="{DynamicResource Style.CardQuiet}" Padding="14">
            <StackPanel><TextBlock Text="{loc:Loc history.selected}" Style="{DynamicResource Style.SectionLabel}" /><Border Margin="0,8,0,0" Style="{DynamicResource Style.Card}" Padding="12" Effect="{x:Null}"><TextBlock x:Name="HistoryDetailText" FontFamily="Consolas" FontSize="10.5" TextWrapping="Wrap" Foreground="{DynamicResource Brush.TextSecondary}" Text="{loc:Loc history.select_entry}" /></Border></StackPanel>
        </Border>
    </Grid>
</UserControl>
