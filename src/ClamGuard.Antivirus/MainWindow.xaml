<controls:ClamGuardWindow x:Class="ClamGuard.Antivirus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:ClamGuard.Antivirus.Controls"
        xmlns:loc="clr-namespace:ClamGuard.Antivirus.Localization"
        WindowStartupLocation="CenterScreen"
        Title="ClamGuard Antivirus"
        Width="975" Height="685" 
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        ShowInTaskbar="True">

    <Grid Background="{DynamicResource Brush.WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="228" MinWidth="210" MaxWidth="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{DynamicResource Brush.Sidebar}"
                BorderBrush="{DynamicResource Brush.Border}" BorderThickness="0,0,1,0">
            <Grid Margin="0,20,0,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Margin="20,0,20,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="48" Height="48" Background="{DynamicResource Brush.PrimarySoft}" CornerRadius="12">
                        <Path Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Fill="{DynamicResource Brush.Primary}" Stretch="Uniform" Data="{DynamicResource Icon.AppLogo}" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc app.title}" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" />
                        <TextBlock Text="{loc:Loc app.subtitle}" Margin="0,2,0,0" FontSize="10"
                                   Foreground="{DynamicResource Brush.TextMuted}" />
                    </StackPanel>
                </Grid>

                <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="8,0,8,0">
                    <StackPanel>
                        <RadioButton x:Name="NavOverview" Content="{loc:Loc nav.overview}" Tag="Overview" GroupName="Navigation"
                                     IsChecked="True" Click="Nav_Click" Style="{DynamicResource Style.NavItem}" />
                        <RadioButton x:Name="NavScan" Content="{loc:Loc nav.scan}" Tag="Scan" GroupName="Navigation"
                                     Click="Nav_Click" Style="{DynamicResource Style.NavItem}" />
                        <RadioButton x:Name="NavUpdate" Content="{loc:Loc nav.update}" Tag="Update" GroupName="Navigation"
                                     Click="Nav_Click" Style="{DynamicResource Style.NavItem}" />
                        <RadioButton x:Name="NavHistory" Content="{loc:Loc nav.history}" Tag="History" GroupName="Navigation"
                                     Click="Nav_Click" Style="{DynamicResource Style.NavItem}" />
                        <RadioButton x:Name="NavQuarantine" Content="{loc:Loc nav.quarantine}" Tag="Quarantine" GroupName="Navigation"
                                     Click="Nav_Click" Style="{DynamicResource Style.NavItem}" />
                        <RadioButton x:Name="NavTools" Content="{loc:Loc nav.tools}" Tag="Tools" GroupName="Navigation"
                                     Click="Nav_Click" Style="{DynamicResource Style.NavItem}" />
                    </StackPanel>
                </ScrollViewer>

                <!-- Settings pinned at the bottom above engine status -->
                <StackPanel Grid.Row="3" Margin="8,8,8,0">
                    <RadioButton x:Name="NavSettings" Content="{loc:Loc nav.settings}" Tag="Settings" GroupName="Navigation"
                                 Click="Nav_Click" Style="{DynamicResource Style.NavItem}" />
                </StackPanel>

                <Border Grid.Row="4" Margin="14,12,14,0" Padding="12"
                        Background="{DynamicResource Brush.SurfaceSubtle}" BorderBrush="{DynamicResource Brush.Border}"
                        BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="{loc:Loc nav.engine}" Style="{DynamicResource Style.SectionLabel}" />
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Ellipse Width="7" Height="7" VerticalAlignment="Center" Style="{DynamicResource Style.ReadyDot}" />
                            <TextBlock Margin="7,0,0,0" VerticalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Style="{DynamicResource Style.ReadyText}" Text="{Binding DatabaseStatusText}" />
                        </StackPanel>
                        <TextBlock Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource Brush.TextMuted}"
                                   Text="{Binding SignatureCount, StringFormat={}{0:N0} signatures}" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="{DynamicResource Brush.WindowBackground}">
            <Grid Margin="30,24,30,24">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,20,0" MinWidth="0">
                        <TextBlock Text="{loc:Loc app.caption}" Style="{DynamicResource Style.SectionLabel}" />
                        <TextBlock Text="{Binding HeaderTitle}" Margin="0,5,0,0" FontSize="25" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Brush.TextPrimary}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding HeaderSubtitle}" Margin="0,4,0,0" FontSize="11.5"
                                   Foreground="{DynamicResource Brush.TextMuted}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Button Grid.Column="1" Command="{Binding UpdateCommand}" Style="{DynamicResource Style.ButtonSecondary}"
                            Height="36" Padding="12,7" HorizontalAlignment="Right" VerticalAlignment="Center"
                            IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}"
                            ToolTip="{loc:Loc update.update_now}">
                        <StackPanel Orientation="Horizontal">
                            <Path Width="16" Height="16" Stroke="{DynamicResource Brush.TextSecondary}" StrokeThickness="1.5"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                  Stretch="Uniform" Data="{DynamicResource Icon.Update}" />
                            <TextBlock Text="{loc:Loc common.update}" Margin="7,0,0,0" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Non-intrusive Top Progress Line during Background Operations -->
                <ProgressBar Grid.Row="1" Height="2.5" VerticalAlignment="Center"
                             IsIndeterminate="{Binding IsBusy}"
                             Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}"
                             Style="{DynamicResource Style.ProgressBar}" />

                <ContentControl Grid.Row="2" Content="{Binding CurrentView}" />
            </Grid>
        </Grid>
    </Grid>
</controls:ClamGuardWindow>
